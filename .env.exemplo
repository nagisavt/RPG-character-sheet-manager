# Copie para `.env` e escolha a senha. O `.env` não é versionado.
#
# É a senha que o mestre digita em /mestre, no notebook dele. Ela não protege
# nada de terceiros — a rede é a da sala — ela impede que o celular de um jogador
# entre como mestre e declare o que aconteceu na Mesa.
SENHA_MESTRE=troque-esta-senha

# Opcional. O default é 3000.
# PORTA=3000
